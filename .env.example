# =========================================================
# Variables globales del proyecto TFG Chatbot RAG
# Copia este archivo a .env y rellena los valores reales
# =========================================================

# -------------------------
# PostgreSQL (infra/n8n/docker-compose.yaml)
# -------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA
POSTGRES_DB=n8n

# -------------------------
# n8n (infra/n8n/docker-compose.yaml)
# IMPORTANTE: no cambies N8N_ENCRYPTION_KEY si ya tienes
# credenciales guardadas en una instalación existente
# -------------------------
N8N_ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_HEX_LARGA
N8N_USER_MANAGEMENT_JWT_SECRET=CAMBIAR_POR_OTRA_CLAVE_HEX_LARGA

# -------------------------
# Zona horaria
# -------------------------
GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

# -------------------------
# Flags útiles de n8n
# -------------------------
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_SECURE_COOKIE=false

# -------------------------
# Opcionales futuros
# Déjalos comentados si no los usas todavía
# -------------------------
# N8N_HOST=localhost
# N8N_PORT=5678
# N8N_PROTOCOL=http
# WEBHOOK_URL=http://localhost:5678/
# OLLAMA_HOST=http://localhost:11434
# QDRANT_URL=http://localhost:6333
# BACKEND_URL=http://localhost:8000
